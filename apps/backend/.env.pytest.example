
SQL_DATABASE_URL=sqlite+aiosqlite://
REDIS_DATABASE_URL=redis://localhost:16379

# Test-only values. All API and Worker processes must share the same impersonation key.
ACCESS_TOKEN_KEY=pytest-only-access-secret
REFRESH_TOKEN_KEY=pytest-only-refresh-secret
IMPERSONATION_TOKEN_KEY=pytest-only-impersonation-secret
IMPERSONATION_SESSION_EXP=3600
