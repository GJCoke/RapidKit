# ============================================================
# Production Environment Variables
# Copy to .env.prod and fill in real values before deploying
# ============================================================

# --- Environment ---
ENVIRONMENT=PRODUCTION

# --- PostgreSQL ---
POSTGRESQL_ASYNC_SCHEME=postgresql+asyncpg
POSTGRESQL_SYNC_SCHEME=postgresql+psycopg
POSTGRESQL_USERNAME=root
POSTGRESQL_PASSWORD=CHANGE_ME_pg_password
POSTGRESQL_HOST=postgresql
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=client

# --- Redis ---
REDIS_SCHEME=redis
REDIS_ROOT_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=10

# --- Celery ---
CELERY_REDIS_DATABASE=1
# Empty list discovers all workers. Each replica uses celery@%h.
CELERY_WORKER_NAMES=[]
DATETIME_TIMEZONE=Asia/Shanghai

# --- MinIO ---
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- Auth (REQUIRED in production) ---
ACCESS_TOKEN_KEY=CHANGE_ME_access_token_secret
REFRESH_TOKEN_KEY=CHANGE_ME_refresh_token_secret
# Separate from both ordinary signing secrets; use a long random value.
IMPERSONATION_TOKEN_KEY=CHANGE_ME_impersonation_token_secret
# Durations in seconds: access 15 minutes, refresh 7 days. Signing is HS256 only.
ACCESS_TOKEN_EXP=900
REFRESH_TOKEN_EXP=604800
# Required PEM keys in production. Generate a matching RSA pair before deploying.
# In an env file use quoted PEM strings with literal \n between lines.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# --- CORS ---
CORS_ORIGINS=["https://your-domain.com"]
CORS_HEADERS=["*"]

# --- Socket.IO Admin ---
SOCKETIO_ADMIN_USERNAME=admin
SOCKETIO_ADMIN_PASSWORD=CHANGE_ME_socketio_password

# --- Trusted proxy ---
# Must match the compose network subnet. Change both when the subnet conflicts.
# nginx is the first public hop; do not trust arbitrary forwarded headers.
FORWARDED_ALLOW_IPS=172.30.0.0/24

# 默认额度按用户或匿名真实 IP，敏感入口额度叠加；所有副本共享 Redis 计数。
RATE_LIMIT_AUTHENTICATED=600/minute
RATE_LIMIT_ANONYMOUS=120/minute
RATE_LIMIT_LOGIN_ACCOUNT=10/minute
RATE_LIMIT_LOGIN_IP=200/minute
RATE_LIMIT_RESET_ACCOUNT=5/minute
RATE_LIMIT_RESET_IP=60/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_CREDENTIAL_SETUP=30/minute

# 部署环境默认单行 JSON stdout；显式设 false 可恢复文本，文件日志保留原格式。
LOG_JSON=true

# 可选接入外部 Sentry；留空时 API、worker、beat 都不启用，无需额外容器。
# 默认仅上报错误，不启用性能采样。请求体、cookies、认证头和 URL 查询不上传。
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0

# /metrics 仅供内部抓取；nginx 禁止公开访问。Compose 只给 API 容器导出
# PROMETHEUS_MULTIPROC_DIR=/tmp/rapidkit-prometheus（必须在 import 前成为 OS env）。
# 不要在共享 env_file 中设置此变量；worker/beat/migrate 的 entrypoint 会移除它。
# 每个 API 副本都有独立目录，scraper 必须逐副本抓取，不能经 nginx 随机取样。
